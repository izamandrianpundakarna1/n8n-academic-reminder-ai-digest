      "position": [
        920,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram Account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "6609227285",
        "text": "=📰 *DAILY AI & TECH DIGEST*\n\n{{ $json.response }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Kirim Digest Berita to Telegram",
