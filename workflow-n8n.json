{
  "name": "Asisten Kuliah - Pengingat Tugas & AI News Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7,20 * * *"
            }
          ]
        }
      },
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Schedule Trigger (07.00 & 20.00)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "YOUR_NOTION_DATABASE_ID",
          "mode": "list"
        },
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "key": "Status|select",
              "condition": "equals",
              "value": "Belum Selesai"
            }
          ]
        }
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Ambil Tugas dari Notion",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        480,
        200
      ],
      "credentials": {
        "notionApi": {
          "id": "NOTION_CREDENTIAL_ID",
          "name": "Notion Account"
        }
      }
    },
    {
      "parameters": {
        "url": "https://www.antaranews.com/rss/ekonomi"
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "Fetch RSS Feed Berita",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.1,
      "position": [
        480,
        420
      ]
    },
    {
      "parameters": {
        "prompt": "=Tolong rangkumkan artikel berita teknologi, AI, dan ekonomi berikut menjadi 3 poin ringkas dalam bahasa Indonesia yang ramah dan mudah dipahami:\n\nJudul: {{ $json.title }}\nRingkasan: {{ $json.contentSnippet || $json.content }}",
        "modelName": "models/gemini-1.5-flash"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Rangkum Berita via Gemini AI",
      "type": "n8n-nodes-langchain.googleGemini",
      "typeVersion": 1,
      "position": [
        700,
        420
      ],
      "credentials": {
        "googleGeminiApi": {
          "id": "GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "chatId": "6609227285",
        "text": "=📚 *PENGINGAT TUGAS KULIAH*\n\nBerikut daftar tugas yang perlu kamu selesaikan:\n- Task: {{ $json.name }}\n- Deadline: {{ $json.deadline }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "Kirim Pengingat Tugas to Telegram",
